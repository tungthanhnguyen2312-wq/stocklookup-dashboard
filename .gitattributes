data/sector_heatmap.js          -text
data/candlestick_patterns.json  -text
data/candlestick_patterns.js    -text
data/macro_snapshot.json        -text
data/macro_snapshot.js          -text
data/current_decision_cockpit.json -text
data/screener_data.js           -text
data/build_info.json            -text
data/build_info.js              -text
