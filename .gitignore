# --------------------------------------------------------------------------
# Bổ sung 2026-07-13 (c) — chặn reports/ sau khi phát hiện dữ liệu tài chính
# thật (mã PAN) bị lọt vào lịch sử git local qua nhánh migration missing-data.
# reports/ chứa số liệu BCTC thật trích xuất cho việc audit/rebuild snapshot
# (EBIT/SGA/retained_earnings/OCF...) — CÙNG NGUYÊN TẮC với financial_snapshot.*
# ở trên: dữ liệu cá nhân, KHÔNG được lên GitHub. File vẫn giữ nguyên trên đĩa
# để dùng cục bộ, chỉ chặn khỏi git.
reports/
# --------------------------------------------------------------------------

# LƯU Ý CÓ CHỦ ĐÍCH — những thứ KHÔNG ignore vì web cần:
#   data/                -> candle_signals/sector_heatmap/screener_data (dashboard sống bằng nó)
#   screen_snapshot.csv  -> screener.html fetch trực tiếp (~0.3MB, chấp nhận được)
#   market_breadth.csv   -> screener.html fetch trực tiếp (~2KB)
# File NẶNG thật đã chặn theo tên ở đầu file (vn_stock.db, *.parquet, ohlcv_flat.csv)
# --------------------------------------------------------------------------
logs/

# Tooling binary cục bộ (Tailwind CLI standalone) — tải về bởi build_frontend.bat,
# không commit executable. Output CSS (assets/css/tailwind.generated.css) VẪN commit.
tools/
!tools/
tools/*
!tools/build_current_decision_cockpit.py
!tools/build_investment_decision_workspace.py
!tools/verify_candlestick_release_binding.cjs
!tools/ci_change_lane.py

# Local-only, identity-bound decision cockpit projections.  These are built from
# an explicit Daily Research Session Operation; never treat a directory scan as
# current research truth and never publish this local workspace data by default.
local-data/

# --------------------------------------------------------------------------
