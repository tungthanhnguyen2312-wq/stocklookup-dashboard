# ==========================================================================
# .gitignore — VNSTOCK: chỉ dashboard (index.html + data/) được đẩy lên GitHub Pages.
# publish_dashboard.py luôn add THEO TÊN FILE cụ thể (không bao giờ `git add .`),
# file này là lớp phòng thủ THỨ HAI phòng khi lỡ tay add bằng tay.
# ==========================================================================

# Kho dữ liệu gốc — TUYỆT ĐỐI không đẩy (nặng + là tài sản dữ liệu cá nhân)
vn_stock.db
*.parquet
ohlcv_flat.csv

# Python
__pycache__/
*.pyc
.venv/

# Bí mật / cấu hình cục bộ (API key nằm trong biến môi trường, không có file key,
# nhưng chặn sẵn các dạng phổ biến)
.env
*.key
.claude/

# Log của publish_dashboard.py (chỉ có ý nghĩa cục bộ)
publish_log.txt

# --------------------------------------------------------------------------
# Bổ sung 2026-07-11 — nguyên tắc: chỉ đẩy CODE + UI + dữ liệu web cần.
# Dữ liệu cá nhân / output trung gian không lên GitHub:
blacklist.csv
tickers.txt
# ai_report có ngày = bản cá nhân (ignore); ai_report_latest.* là dữ liệu SITE CẦN (không ignore)
ai_report_2*.json
ai_report_2*.md
ai_prompt_preview.txt
# Code pipeline ở LOCAL — repo này là WEBSITE (đã dọn .py khỏi remote 10/07).
# Lưu ý: tài liệu vận hành pipeline (TRACKED — public khi push) từ 12/07 nằm ở docs/
# (README.md giờ chỉ là landing page, xem docs/USER_GUIDE.md + docs/CLI_REFERENCE.md)
*.py
# Operational publisher source; keep this one entry point visible to Git.
!publish_dashboard.py
# publish_dashboard.py's release-session/trusted-subset validation dependencies — must
# ship alongside it or the import fails on a fresh clone.
!release_session_contract.py
!trusted_subset_contract.py
# ...trừ bộ test hồi quy (fixture bịa, không có dữ liệu thật — commit kèm repo 12/07;
# lưu ý test cần stock_analyzer.py nằm cạnh nên chỉ chạy được trên máy local)
!tests/**/*.py
news_latest.csv
macro_snapshot.csv
ta_signals.csv
ta_signals.json
*.xlsx
logs/
archive_md5_cache.json
# Output cá nhân của stock_analyzer.py.
# analysis_latest.json: đã BỎ ignore (12/07/2026) — analysis.html/analysis.js dùng nó làm
# nguồn DUY NHẤT (không có fallback .js như signals.html/screener.html), nên nó là dữ liệu
# WEB CẦN, không phải output cá nhân; publish_dashboard.py tự bóc whitelist từ analysis.html.
# analysis_latest.md vẫn ignore — chỉ để đọc tay, không trang nào tham chiếu.
analysis_latest.md
Focus_Analysis.md
Market_Scan.md
Market_Scan.csv

